{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The deployed Worker keeps its original name (renaming would create a new Worker and orphan the
  // custom domains bound to this one).
  "name": "web",
  "compatibility_date": "2026-09-15",
  "account_id": "96951f7c7cb11abdb9281c9efe7be54f",
  "workers_dev": false,
  "routes": [
    { "pattern": "alienlabs.io", "custom_domain": true },
    { "pattern": "www.alienlabs.io", "custom_domain": true },
    { "pattern": "alienlaboratories.com", "custom_domain": true },
    { "pattern": "www.alienlaboratories.com", "custom_domain": true },
  ],
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
